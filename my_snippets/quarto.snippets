snippet pb "Python Code Block" b
\`\`\`{python}
${1:# Your Python code here}
\`\`\`
endsnippet

snippet rb "R Code Block" b
\`\`\`{r}
${1:# Your R code here}
\`\`\`
endsnippet

snippet head "Quarto header" bA
---
title: $1
format: html
---
endsnippet

snippet lib "Library" bA
library($0)
endsnippet

snippet swd "Set working directory" bA
setwd($0)
endsnippet

snippet columns "Columns environment" bA
:::{.columns}
:::{.column width="50%"}
$0
:::
:::{.column width="50%"}

:::
:::
endsnippet

snippet fragment "Fragment environment" bA
:::{.fragment}
$0
:::
endsnippet
